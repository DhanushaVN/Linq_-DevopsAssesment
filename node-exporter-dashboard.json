{
  "id": null,
  "uid": "node-exporter-custom",
  "title": "Custom Node Exporter Dashboard",
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "type": "gauge",
      "title": "CPU Usage %",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "gauge",
      "title": "Memory Usage %",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "graph",
      "title": "Disk Usage %",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 5 },
      "targets": [
        {
          "expr": "100 * (1 - (node_filesystem_free_bytes{fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"}))",
          "refId": "A",
          "legendFormat": "{{mountpoint}} ({{instance}})"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Load Average (1m)",
      "gridPos": { "x": 0, "y": 9, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "node_load1",
          "refId": "A"
        }
      ]
    },
    {
      "type": "graph",
      "title": "Network Traffic",
      "gridPos": { "x": 6, "y": 9, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total[5m])",
          "refId": "A",
          "legendFormat": "Receive - {{instance}}"
        },
        {
          "expr": "rate(node_network_transmit_bytes_total[5m])",
          "refId": "B",
          "legendFormat": "Transmit - {{instance}}"
        }
      ]
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": []
  }
}

